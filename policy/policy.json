      "vendor": "google",
      "pool": "metered"
    },
    "gemini-visual": {
      "type": "external",
      "instruction": "Gemini Flash implements this narrowly scoped visual task. Astra reasons and directs; see `~/.claude/skills/gemini-ui-design/SKILL.md`.",
      "requiresSpendApproval": true,
      "vendor": "google",
      "pool": "metered"
    },
    "openai-image": {
      "type": "external",
      "instruction": "Generate with OpenAI image generation.",
      "requiresSpendApproval": true,
      "vendor": "openai",
      "pool": "metered"
